{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((q,s)=>{require('fs').readFile('index.html',(e,d)=>{s.writeHead(e?404:200,{'Content-Type':'text/html; charset=utf-8'});s.end(d)})}).listen(8123)"],
      "port": 8123
    }
  ]
}
