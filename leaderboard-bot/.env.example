# Discord bot token, from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# The channel ID where scores get posted (right-click the channel in Discord with
# Developer Mode on -> Copy Channel ID). Leave blank to watch every channel the bot can see.
DISCORD_CHANNEL_ID=

# From your Supabase project -> Project Settings -> API -> service_role secret.
# This key bypasses Row Level Security, so it only ever lives here, never in the website.
SUPABASE_URL=https://zhvcrzybpnxmbnwjnqyf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# IANA timezone used to decide which calendar day a score counts for,
# and the timezone ROULETTE_HOUR below is interpreted in.
TIMEZONE=Europe/Oslo

# 24h clock hour (in TIMEZONE) when the bonus mascot's roulette spin
# fires for whoever had the worst day. Defaults to 16 if unset.
ROULETTE_HOUR=16
