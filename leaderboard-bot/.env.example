# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — it must NEVER be committed or edited on github.com.

# Discord bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Scores channel: Discord with Developer Mode on -> right-click channel -> Copy Channel ID.
# Leave blank to watch every channel the bot can see (but then bonus announcements have nowhere to post).
DISCORD_CHANNEL_ID=

# Supabase -> Project Settings -> API. Use a SECRET key (sb_secret_...) or the legacy service_role JWT.
# Bypasses Row Level Security, so it lives ONLY here, never in the website or a commit.
SUPABASE_URL=https://zhvcrzybpnxmbnwjnqyf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# IANA timezone: which calendar day a score counts for, and the tz ROULETTE_HOUR is read in.
TIMEZONE=Europe/Oslo

# 24h hour (in TIMEZONE) the bonus mascot's roulette spin fires for whoever had the worst day.
ROULETTE_HOUR=16
